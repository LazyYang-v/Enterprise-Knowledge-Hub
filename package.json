{
  "name": "enterprise-knowledge-hub",
  "version": "1.0.0",
  "description": "企业知识库 —— RAG 问答、智能体与知识库管理的一体化平台",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:pg": "node --test --test-concurrency=1 test/pg/*.test.js",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:dry": "node scripts/migrate.js up --dry-run",
    "db:status": "node scripts/migrate.js status",
    "worker": "node scripts/worker.js",
    "worker:once": "node scripts/worker.js --once",
    "worker:reap": "node scripts/worker.js --reap-only",
    "artifacts:gc": "node scripts/artifacts-gc.js",
    "repro:baseline": "node scripts/repro-c1-c8.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.5.16",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}
