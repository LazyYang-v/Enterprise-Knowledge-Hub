{
  "phase": "P0-3",
  "purpose": "确定性验证引用字段、版本固定与越权收缩；不做模型级评分（P0-6）。",
  "cases": [
    {
      "id": "CIT-01",
      "kind": "normal",
      "query": "差旅住宿标准",
      "scope": { "mode": "explicit" },
      "expect": {
        "min_results": 1,
        "required_fields": [
          "evidence_id", "document_id", "document_version", "chunk_id",
          "content_hash", "title", "kb_id", "kb_name", "locator", "excerpt", "retrieved_at"
        ],
        "untrusted": true
      }
    },
    {
      "id": "CIT-02",
      "kind": "boundary",
      "query": "不存在的主题 XQZ-9931",
      "scope": { "mode": "explicit" },
      "expect": { "max_results": 0 }
    },
    {
      "id": "CIT-03",
      "kind": "failure",
      "query": "越权知识库内容",
      "scope": { "mode": "explicit", "foreign_kb": true },
      "expect": { "http_status": 403, "leak": false }
    },
    {
      "id": "CIT-04",
      "kind": "normal",
      "query": "版本化内容 OLD7F3K9",
      "scope": { "mode": "explicit" },
      "setup": "文档已从版本 1 重解析到版本 2",
      "expect": { "document_version": 1, "reason": "任务已固定版本" }
    },
    {
      "id": "CIT-05",
      "kind": "boundary",
      "query": "版本化内容 NEW2M8P4",
      "scope": { "mode": "explicit", "version_policy": "latest" },
      "expect": { "document_version": 2 }
    },
    {
      "id": "CIT-06",
      "kind": "failure",
      "query": "finish 引用未知 evidence_id",
      "expect": { "task_status": "not_completed", "error_code": "model_invalid_output", "retryable": true }
    }
  ]
}
