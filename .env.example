# 服务端口
PORT=3210

# 网络搜索工具（可选）：配置后可在工具箱中开启「网络搜索」
TAVILY_API_KEY=

# 控制面 PostgreSQL（P0-0 起）。本地开发：docker compose up -d postgres
DATABASE_URL=postgres://ekh:ekh_dev_password@127.0.0.1:55432/ekh
# 迁移测试使用独立数据库（docker 初始化时自动创建）
# DATABASE_URL=postgres://ekh:ekh_dev_password@127.0.0.1:55432/ekh_test

# Agent 平台特性开关；P0-2 起启用 /api/tasks 与 /api/approvals
AGENT_PLATFORM_ENABLED=0

# 任务 Worker 使用的模型（P0-2 从环境变量读取，P0-4 起迁移到 model_profiles/credential_ref）
EKH_AGENT_MODEL_BASE_URL=
EKH_AGENT_MODEL_NAME=
EKH_AGENT_MODEL_API_KEY=

# Worker 参数（毫秒）；一般无需修改
# EKH_WORKER_ID=
# EKH_WORKER_LEASE_TTL_MS=60000
# EKH_WORKER_HEARTBEAT_MS=20000
# EKH_WORKER_REAPER_MS=15000
# EKH_WORKER_POLL_MS=1000
# EKH_TASK_RETRY_BASE_MS=5000
# EKH_WORKER_SHUTDOWN_GRACE_MS=10000

# 数据目录覆盖（测试/多实例用），留空表示 <repo>/data
EKH_DATA_DIR=

# 开发环境演示数据开关；生产环境始终禁用
EKH_ENABLE_DEMO_SEED=1

# 平台管理员邮箱（逗号分隔）；用于 Skill reload 等平台级操作
PLATFORM_ADMIN_EMAILS=

# —— P0-3 知识检索与 Skill ——
# 检索候选上限（SQL 先过滤，再计算向量）
EKH_KNOWLEDGE_CANDIDATE_LIMIT=5000
# 单次检索返回上限
EKH_KNOWLEDGE_TOP_K_MAX=20
# FTS 命中上限
EKH_KNOWLEDGE_FTS_LIMIT=80
# 引用摘录字符数
EKH_KNOWLEDGE_EXCERPT_CHARS=2000
# 注入任务提示词的证据条数
EKH_KNOWLEDGE_EVIDENCE_MAX=8
# 服务令牌（/api/retrieve、MCP）可访问的 KB，逗号分隔；留空表示不限
EKH_SERVICE_KB_SCOPE=
# Skill 根目录；留空表示 <repo>/skills
EKH_SKILLS_DIR=
# SKILL.md 最大字符数（超出拒绝加载）
EKH_SKILL_INSTRUCTION_MAX_CHARS=8000

# —— P0-4 工具、审批、沙箱、MCP 与服务身份 ——
# 自定义工具沙箱：process（默认）/ required（无 Node 权限模型则拒绝）/ off（仅受控开发）
EKH_TOOL_SANDBOX_MODE=process
EKH_TOOL_TIMEOUT_MS=15000
EKH_TOOL_MAX_OUTPUT_CHARS=8000
EKH_TOOL_SANDBOX_MEMORY_MB=256
# 审批有效期：普通 / 高风险（code_exec、external_send 等）
EKH_TOOL_APPROVAL_TTL_MS=86400000
EKH_TOOL_HIGH_RISK_APPROVAL_TTL_MS=3600000
# 工具目录注入系统提示词上限、单任务工具数量上限
EKH_TOOL_CATALOG_MAX_CHARS=12000
EKH_TOOL_MAX_PER_TASK=20
# 出站 MCP（仅 Streamable HTTP）；stdio 暂不启用
EKH_MCP_CLIENT_TIMEOUT_MS=15000
EKH_MCP_STDIO_ENABLED=0
# file: 形式 credential_ref 的根目录（必须位于其中）
EKH_MODEL_SECRET_DIR=
# 是否兼容旧 EKH_SERVICE_TOKEN；生产建议 0
EKH_SERVICE_LEGACY_TOKEN_ENABLED=1

# —— P0-5 成果面与文件工具 ——
# 单个成果上限（字节）；默认 25 MiB
EKH_ARTIFACT_MAX_BYTES=26214400
# 单任务成果总量 / 数量上限
EKH_ARTIFACT_MAX_TASK_BYTES=104857600
EKH_ARTIFACT_MAX_PER_TASK=100
# 单次 HTTP 上传上限（字节）
EKH_ARTIFACT_UPLOAD_MAX_BYTES=26214400
# 软删除后 blob GC 宽限期（毫秒）
EKH_ARTIFACT_GC_GRACE_MS=86400000
# document.read 单次返回 / 文本抽取总字符上限
EKH_FILE_MAX_READ_CHARS=6000
EKH_FILE_EXTRACT_MAX_CHARS=200000
# ZIP 护栏：条目数 / 单条解压 / 总解压 / 压缩比
EKH_ZIP_MAX_ENTRIES=200
EKH_ZIP_MAX_ENTRY_BYTES=10485760
EKH_ZIP_MAX_TOTAL_BYTES=41943040
EKH_ZIP_MAX_RATIO=100
# 表格读取行列上限
EKH_SHEET_MAX_ROWS=5000
EKH_SHEET_MAX_COLS=100
