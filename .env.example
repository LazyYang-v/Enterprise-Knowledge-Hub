# 服务端口
PORT=3210

# 网络搜索工具（可选）：配置后可在工具箱中开启「网络搜索」
TAVILY_API_KEY=

# 控制面 PostgreSQL（P0-0 起）。本地开发：docker compose up -d postgres
DATABASE_URL=postgres://ekh:ekh_dev_password@127.0.0.1:55432/ekh
# 迁移测试使用独立数据库（docker 初始化时自动创建）
# DATABASE_URL=postgres://ekh:ekh_dev_password@127.0.0.1:55432/ekh_test

# Agent 平台特性开关；P0-2 起启用 /api/tasks 与 /api/approvals
AGENT_PLATFORM_ENABLED=0

# 任务 Worker 使用的模型（P0-2 从环境变量读取，P0-4 起迁移到 model_profiles/credential_ref）
EKH_AGENT_MODEL_BASE_URL=
EKH_AGENT_MODEL_NAME=
EKH_AGENT_MODEL_API_KEY=

# Worker 参数（毫秒）；一般无需修改
# EKH_WORKER_ID=
# EKH_WORKER_LEASE_TTL_MS=60000
# EKH_WORKER_HEARTBEAT_MS=20000
# EKH_WORKER_REAPER_MS=15000
# EKH_WORKER_POLL_MS=1000
# EKH_TASK_RETRY_BASE_MS=5000
# EKH_WORKER_SHUTDOWN_GRACE_MS=10000

# 数据目录覆盖（测试/多实例用），留空表示 <repo>/data
EKH_DATA_DIR=

# 开发环境演示数据开关；生产环境始终禁用
EKH_ENABLE_DEMO_SEED=1

# 平台管理员邮箱（逗号分隔）；用于 Skill reload 等平台级操作
PLATFORM_ADMIN_EMAILS=

# —— P0-3 知识检索与 Skill ——
# 检索候选上限（SQL 先过滤，再计算向量）
EKH_KNOWLEDGE_CANDIDATE_LIMIT=5000
# 单次检索返回上限
EKH_KNOWLEDGE_TOP_K_MAX=20
# FTS 命中上限
EKH_KNOWLEDGE_FTS_LIMIT=80
# 引用摘录字符数
EKH_KNOWLEDGE_EXCERPT_CHARS=2000
# 注入任务提示词的证据条数
EKH_KNOWLEDGE_EVIDENCE_MAX=8
# 服务令牌（/api/retrieve、MCP）可访问的 KB，逗号分隔；留空表示不限
EKH_SERVICE_KB_SCOPE=
# Skill 根目录；留空表示 <repo>/skills
EKH_SKILLS_DIR=
# SKILL.md 最大字符数（超出拒绝加载）
EKH_SKILL_INSTRUCTION_MAX_CHARS=8000
